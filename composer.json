{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "osamaelnagar/filament-liquid-glass",
    "description": "Liquid Glass theme + configurable chrome for Filament v5 panels: ambient art layers (aurora, images, custom HTML/objects/views), floating/collapsible sidebar, floating/sticky topbar, and a deep glass surface system.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Osama Mohammed Elnagar",
            "homepage": "https://github.com/OsamaElnagar",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/OsamaElnagar/filament-liquid-glass",
    "support": {
        "issues": "https://github.com/OsamaElnagar/filament-liquid-glass/issues",
        "source": "https://github.com/OsamaElnagar/filament-liquid-glass"
    },
    "keywords": ["filament", "filament-plugin", "theme", "glassmorphism", "liquid-glass", "laravel"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^11.28|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.3",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Osama\\FilamentLiquidGlass\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osama\\FilamentLiquidGlass\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@analyse",
            "@lint:check",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osama\\FilamentLiquidGlass\\LiquidGlassServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
